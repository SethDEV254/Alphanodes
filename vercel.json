{
  "buildCommand": "cd backend && npm ci && cd ../frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path]" },
    { "src": "/health", "dest": "/api/[...path]" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/payouts", "schedule": "0 0 * * *" }
  ]
}
